{
  "name": "ahmed-sghaier-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Production portfolio and content operations platform.",
  "author": "Ahmed Sghaier <a7mado008@gmail.com>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0 <26"
  },
  "scripts": {
    "build:packages": "pnpm --filter @portfolio/core build && pnpm --filter @portfolio/db build",
    "dev": "pnpm build:packages && node scripts/dev.mjs all",
    "dev:portfolio": "pnpm build:packages && node scripts/dev.mjs portfolio",
    "dev:admin": "pnpm build:packages && node scripts/dev.mjs admin",
    "dev:api": "pnpm build:packages && node scripts/dev.mjs api",
    "build": "node scripts/with-env.mjs pnpm -r --if-present build",
    "build:portfolio": "node scripts/with-env.mjs pnpm --filter @portfolio/portfolio build",
    "build:admin": "node scripts/with-env.mjs pnpm --filter @portfolio/admin build",
    "build:api": "node scripts/with-env.mjs pnpm --filter @portfolio/api build",
    "lint": "eslint apps packages e2e scripts --max-warnings=0",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:e2e": "node scripts/with-env.mjs pnpm exec playwright test",
    "storybook": "pnpm --filter @portfolio/ui storybook",
    "build-storybook": "pnpm --filter @portfolio/ui build-storybook",
    "db:migrate": "pnpm --filter @portfolio/core build && node scripts/with-env.mjs pnpm --filter @portfolio/db migrate",
    "db:seed": "pnpm --filter @portfolio/core build && node scripts/with-env.mjs pnpm --filter @portfolio/db seed",
    "db:verify": "pnpm --filter @portfolio/db test",
    "docker:config": "./scripts/docker.sh config prod && ./scripts/docker.sh config dev",
    "docker:build": "./scripts/docker.sh build",
    "docker:up": "./scripts/docker.sh up",
    "docker:down": "./scripts/docker.sh down",
    "docker:images": "./scripts/docker.sh images",
    "docker:logs": "./scripts/docker.sh logs",
    "docker:dev:up": "./scripts/dev-docker.sh up",
    "docker:dev:down": "./scripts/dev-docker.sh down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.10.5",
    "dotenv": "^17.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
