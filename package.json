{
  "name": "a7med-sghaier-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Public portfolio single-page application and its shared design and domain packages.",
  "author": "Ahmed Sghaier <a7mado008@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0 <26"
  },
  "scripts": {
    "build:packages": "pnpm --filter @portfolio/core build && pnpm --filter @portfolio/api-client build",
    "dev": "pnpm build:packages && pnpm --filter @portfolio/portfolio dev",
    "build": "pnpm build:packages && pnpm --filter @portfolio/portfolio build",
    "preview": "pnpm --filter @portfolio/portfolio preview",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "storybook": "pnpm --filter @portfolio/ui storybook",
    "build-storybook": "pnpm --filter @portfolio/ui build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^22.10.5",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
